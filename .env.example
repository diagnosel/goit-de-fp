# This execution uses a private local MySQL loaded from the official CSV files.
# setup_local_mysql.py writes actual local passwords into .runtime/local.env.sh.
FP_SOURCE_MYSQL_HOST=127.0.0.1
FP_SOURCE_MYSQL_PORT=13310
FP_SOURCE_MYSQL_SCHEMA=olympic_dataset
FP_SOURCE_MYSQL_USER=fp_source
FP_SOURCE_MYSQL_PASSWORD=
FP_SOURCE_MYSQL_SSL_MODE=REQUIRED
# Output: use your own schema and account with permission to append results.
FP_OUTPUT_MYSQL_HOST=127.0.0.1
FP_OUTPUT_MYSQL_PORT=13310
FP_OUTPUT_MYSQL_SCHEMA=aurika_fp
FP_OUTPUT_MYSQL_USER=fp_output
FP_OUTPUT_MYSQL_PASSWORD=
FP_OUTPUT_MYSQL_SSL_MODE=REQUIRED
FP_KAFKA_BROKER=127.0.0.1:19095
FP_INPUT_TOPIC=athlete_event_results
FP_OUTPUT_TOPIC=athlete_avg_stats_aurika_fp
FP_OUTPUT_TABLE=athlete_avg_stats_aurika_fp
# Set FP_CHECKPOINT and FP_SOURCE_CSV_DIR to your own absolute paths if needed.
# For a remote MySQL, use its real account and SSL_MODE=VERIFY_IDENTITY.
